# App
NODE_ENV=development
PORT=3000
HOST=localhost

# Database (PostgreSQL) — otomatis di-override docker-compose, isi ini untuk local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_db?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=erp_db

# JWT
ACCESS_TOKEN_KEY=your_access_token_secret_min_32_chars
REFRESH_TOKEN_KEY=your_refresh_token_secret_min_32_chars

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
